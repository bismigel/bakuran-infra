#!/bin/sh
# Idempotent baseline for the OpenWrt switch (Netgear GS108T v3).
#
# Runs ON the switch via Ansible's `script` module, because OpenWrt has no Python and
# there is no OpenWrt Terraform/OpenTofu provider (checked 2026-11-01), so Ansible at the
# shell level is the honest tool.
#
#   switch_baseline.sh            apply the baseline, print what changed
#   switch_baseline.sh --audit    change nothing, exit 2 if anything differs
#
# Values come from group_vars/all.yml, rendered into the environment by the playbook.
set -u

# Desired state, rendered by Ansible from group_vars/all.yml. Values are quoted here so
# the script is self-contained on a target with no Python and no Ansible runtime.
SW_HOSTNAME='{{ switch_baseline.hostname }}'
SW_ZONENAME='{{ switch_baseline.zonename }}'
SW_TIMEZONE='{{ switch_baseline.timezone }}'
SW_NTP='{{ switch_baseline.ntp_servers | join(" ") }}'
SW_LAN_IPADDR='{{ switch_baseline.lan_ipaddr }}'
SW_LAN_GATEWAY='{{ switch_baseline.lan_gateway }}'
SW_LAN_DNS='{{ switch_baseline.lan_dns }}'
SW_STP='{{ 1 if switch_baseline.stp else 0 }}'
SW_IGMP='{{ 1 if switch_baseline.igmp_snooping else 0 }}'
SW_DNSMASQ_ENABLED='{{ "true" if switch_baseline.dnsmasq_enabled else "false" }}'
SW_ODHCPD_ENABLED='{{ "true" if switch_baseline.odhcpd_enabled else "false" }}'
SW_SSH_PW='{{ "on" if switch_baseline.ssh_password_auth else "off" }}'
SW_SSH_ROOT_PW='{{ "on" if switch_baseline.ssh_root_password_auth else "off" }}'
SW_LUCI_HTTPS='{{ 1 if switch_baseline.luci_redirect_https else 0 }}'
SW_AUTH_KEYS='{{ switch_baseline.ssh_authorized_keys | join("\n") }}'
# Desired 802.1Q layout, one "vlan:ports" record per LINE. The separator is a newline in the
# template itself, deliberately: the first version separated records with ";" and then split on
# newlines, so the whole string was read as a single record - vlan 1 got the ports
# "lan1 .. lan8;20:lan1:t lan2:t", which added lan2 as TAGGED in VLAN 1 and dropped the AP's
# untagged traffic. That took the only Wi-Fi on the OPNsense island offline.
SW_VLANS='{% for v in switch_baseline.vlans %}{{ v.vlan }}:{{ v.ports | join(" ") }}
{% endfor %}'

AUDIT=0
[ "${1:-}" = "--audit" ] && AUDIT=1

CHANGED=0
DRIFT=""

# want <uci-path> <desired> [list]
check_set() {
  path="$1"; want="$2"; list="${3:-}"
  have="$(uci -q get "$path" 2>/dev/null || true)"
  if [ "$have" = "$want" ]; then return 0; fi
  DRIFT="$DRIFT
  $path: '${have:-<unset>}' -> '$want'"
  CHANGED=1
  [ "$AUDIT" = "1" ] || { uci set "$path=$want"; }
}

# same, for a list option that must equal a specific sequence
check_list() {
  path="$1"; want="$2"
  have="$(uci -q get "$path" 2>/dev/null | tr '\n' ' ' | sed 's/ *$//')"
  wantn="$(printf '%s' "$want" | sed 's/ *$//')"
  if [ "$have" = "$wantn" ]; then return 0; fi
  DRIFT="$DRIFT
  $path: '${have:-<unset>}' -> '$wantn'"
  CHANGED=1
  [ "$AUDIT" = "1" ] || {
    uci -q delete "$path"
    for v in $wantn; do uci add_list "$path=$v"; done
  }
}

check_set system.@system[0].hostname       "${SW_HOSTNAME}"
check_set system.@system[0].zonename       "${SW_ZONENAME}"
check_set system.@system[0].timezone       "${SW_TIMEZONE}"
check_list system.ntp.server               "${SW_NTP}"
check_set network.lan.ipaddr               "${SW_LAN_IPADDR}"
check_set network.lan.gateway              "${SW_LAN_GATEWAY}"
check_list network.lan.dns                 "${SW_LAN_DNS}"
check_set network.@device[1].stp           "${SW_STP}"
check_set network.@device[1].igmp_snooping "${SW_IGMP}"
# The key must exist before passwords are turned off. This runs FIRST and is the reason the
# ordering matters: on 2026-11-01 a factory reset removed the key while the baseline would have
# disabled password auth in the same run - a device nobody could log into.
install_keys() {
  want="$SW_AUTH_KEYS"
  [ -n "$want" ] || { DRIFT="$DRIFT
  ssh_authorized_keys: empty in group_vars - refusing to manage"; CHANGED=1; return 0; }
  mkdir -p /etc/dropbear
  have="$(cat /etc/dropbear/authorized_keys 2>/dev/null || true)"
  missing=0
  oldifs=$IFS; IFS='
'
  for k in $want; do
    [ -n "$k" ] || continue
    printf '%s' "$have" | grep -qF "$k" || missing=$((missing+1))
  done
  IFS=$oldifs
  if [ "$missing" -gt 0 ]; then
    DRIFT="$DRIFT
  authorized_keys: $missing key(s) missing"
    CHANGED=1
    [ "$AUDIT" = "1" ] || {
      touch /etc/dropbear/authorized_keys
      chmod 600 /etc/dropbear/authorized_keys
      oldifs=$IFS; IFS='
'
      for k in $want; do
        [ -n "$k" ] || continue
        grep -qF "$k" /etc/dropbear/authorized_keys || printf '%s\n' "$k" >> /etc/dropbear/authorized_keys
      done
      IFS=$oldifs
    }
  fi
}

install_keys

# Safety interlock: never disable password auth on a device with no key. If the key step failed
# for any reason, keep passwords on and say so loudly rather than lock the device.
if [ "${SW_SSH_PW}" = "off" ] && [ ! -s /etc/dropbear/authorized_keys ]; then
  DRIFT="$DRIFT
  REFUSING to disable password auth: no authorized key present"
  CHANGED=1
  SW_SSH_PW=on
  SW_SSH_ROOT_PW=on
fi

check_set dropbear.main.PasswordAuth        "${SW_SSH_PW}"
check_set dropbear.main.RootPasswordAuth    "${SW_SSH_ROOT_PW}"
check_set uhttpd.main.redirect_https        "${SW_LUCI_HTTPS}"

# Bridge VLANs. Each desired VLAN must exist on the `switch` device with exactly the listed
# ports ("lan1" untagged, "lan1:t" tagged). A tagged VLAN nobody carries is inert, so this
# is what makes the segmentation real rather than documented.
ensure_bridge_vlan() {
  want_vlan="$1"; want_ports="$2"
  found=""
  for sec in $(uci show network | grep "bridge-vlan" | grep -v "device=" | cut -d. -f2 | cut -d= -f1); do
    [ "$(uci -q get "network.$sec.vlan")" = "$want_vlan" ] && found="$sec" && break
  done
  if [ -z "$found" ]; then
    DRIFT="$DRIFT
    vlan $want_vlan: absent -> '$want_ports'"
    CHANGED=1
    [ "$AUDIT" = "1" ] || {
      uci add network bridge-vlan >/dev/null
      found=$(uci show network | grep "bridge-vlan" | tail -1 | cut -d. -f2 | cut -d= -f1)
      uci set "network.$found.device=switch"
      uci set "network.$found.vlan=$want_vlan"
      # IFS is newline-only while the record loop runs (so records split correctly), which
      # means `for p in $want_ports` does NOT split "lan1:t lan2:t" and stores one malformed
      # list item. Every VLAN added by this script hit that; VLAN 20 escaped it only because
      # it was adopted by hand. Found on 2026-11-03 while adding VLAN 30.
      _pifs=$IFS; IFS=' '
      for p in $want_ports; do uci add_list "network.$found.ports=$p"; done
      IFS=$_pifs
    }
    return 0
  fi
  # uci returns list values with single quotes ('lan1:t' 'lan2:t'), so strip them before
  # comparing - otherwise every audit reports drift on a value that matches.
  # uci stores a bridge-vlan's ports either as one space-separated string
  # ('lan1 lan2 ...', which is how vlan 1 is stored and works) or as separate list
  # items ('lan1:t' 'lan2:t', how vlan 20 is stored). Both are valid, so compare the
  # normalised text rather than the storage form: `uci get` joins items with spaces,
  # which makes the two indistinguishable - and is exactly why a storage difference
  # must not be reported as drift.
  have=$(uci -q get "network.$found.ports" | tr '\n' ' ' | tr -d "'" | sed 's/ *$//')
  norm=$(printf '%s' "$want_ports" | sed 's/ *$//')
  if [ "$have" != "$norm" ]; then
    DRIFT="$DRIFT
    vlan $want_vlan ports: '$have' -> '$norm'"
    CHANGED=1
    [ "$AUDIT" = "1" ] || {
      uci -q delete "network.$found.ports"
      for p in $want_ports; do uci add_list "network.$found.ports=$p"; done
      _pifs=$IFS; IFS=' '
      IFS=$_pifs
    }
  fi
}

# NOT `echo ... | while read`: a pipeline runs the loop in a SUBSHELL, so DRIFT and CHANGED
# set inside it are thrown away. The first version of this block did exactly that and the audit
# passed while the device was missing a VLAN - the same "check that cannot fail" shape as the
# rest of this file's history. Iterate with IFS instead, which stays in the current shell.
_old_ifs=$IFS
IFS='
'
for rec in $SW_VLANS; do
  [ -n "$rec" ] || continue
  IFS=':' read -r v p <<EOF
$rec
EOF
  ensure_bridge_vlan "$v" "$p"
done
IFS=$_old_ifs

# Service enablement is state, not a uci value.
for svc in dnsmasq odhcpd; do
  want_enabled="$(eval echo \"\${SW_$(echo "$svc" | tr a-z A-Z)_ENABLED}\")"
  if [ "$want_enabled" = "false" ]; then
    if [ -x "/etc/init.d/$svc" ] && /etc/init.d/"$svc" enabled 2>/dev/null; then
      DRIFT="$DRIFT
  service $svc: enabled -> disabled"
      CHANGED=1
      [ "$AUDIT" = "1" ] || { /etc/init.d/"$svc" stop 2>/dev/null; /etc/init.d/"$svc" disable 2>/dev/null; }
    fi
  fi
done

# A previous run - or one interrupted between `uci set` and `uci commit` - leaves a pending
# delta. `uci get` reports pending values, so every check above sees the desired state while
# the device still runs the old one. Treat a pending delta as drift, or the audit certifies a
# device that was never changed.
PENDING="$(uci changes 2>/dev/null | tr '\n' ' ' | sed 's/ *$//')"
if [ -n "$PENDING" ]; then
  DRIFT="$DRIFT
  pending uci changes never committed: $PENDING"
  CHANGED=1
fi

if [ "$CHANGED" = "0" ]; then
  echo "OK: baseline matches; nothing to change."
  exit 0
fi

if [ "$AUDIT" = "1" ]; then
  echo "DRIFT:$DRIFT"
  exit 2
fi

# Commit every config this script touches. Missing one is invisible: `uci get` still
# reports the pending value (so a re-audit passes) while the running service keeps the old
# one - the same "looks applied, isn't" failure as a probe that cannot fail. Verified
# 2026-11-01: without `uci commit dropbear`/`uhttpd` the hardening below sat in the delta
# and uhttpd kept serving plaintext on :80.
uci commit system; uci commit network; uci commit dropbear; uci commit uhttpd
/etc/init.d/network reload >/dev/null 2>&1
/etc/init.d/sysntpd restart >/dev/null 2>&1
# reload, not restart: this script is running over the very ssh session dropbear serves.
/etc/init.d/dropbear reload >/dev/null 2>&1
/etc/init.d/uhttpd reload >/dev/null 2>&1
echo "CHANGED:$DRIFT"
