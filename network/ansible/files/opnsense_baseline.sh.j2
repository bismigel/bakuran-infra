#!/bin/sh
# Idempotent identity/access baseline for OPNsense.
#
# Runs ON the router over SSH (key auth). The OpenTofu provider has no resource for
# `system` settings, so SSH keys, password-auth policy and the WebGUI session policy can only be
# managed by editing the config through OPNsense's own library - which is what this does.
#
#   opnsense_baseline.sh            apply, print what changed
#   opnsense_baseline.sh --audit    change nothing, exit 2 if anything differs
#
# Deliberately NOT handled here:
#   - TOTP. A seed has to be enrolled in a human's authenticator; automating it would either
#     lock someone out or write a secret we cannot verify. Documented in ROUTER.md instead.
#   - The VLAN/interface objects. Writing them here produces something OPNsense does not
#     enumerate (see ROUTER.md §7c) - they must be created through the UI.
#
# The one dangerous thing this DOES do - turn password auth off - is interlocked: it will not
# run unless at least one authorized key is already present in the config.
set -u

AUDIT=0
[ "${1:-}" = "--audit" ] && AUDIT=1

CHANGED=0
DRIFT=""

add_drift() {
  DRIFT="$DRIFT
  $1"
  CHANGED=1
}

# ---- what we want, rendered by Ansible ---------------------------------------
WANT_KEYS='{{ opnsense_baseline.ssh_authorized_keys | join("\n") }}'
WANT_PW_OFF='{{ "1" if opnsense_baseline.disable_password_auth else "0" }}'
WANT_SESSION='{{ opnsense_baseline.webgui_session_timeout }}'
WANT_AUTH='{{ opnsense_baseline.webgui_auth_timeout }}'
WANT_KEA_IF='{{ opnsense_baseline.kea_interfaces | default("") }}'
WANT_VIF_HANDLE='{{ opnsense_baseline.vlan_interface.handle }}'
WANT_VIF_DESCR='{{ opnsense_baseline.vlan_interface.descr }}'
WANT_VIF_IP='{{ opnsense_baseline.vlan_interface.ipaddr }}'
WANT_VIF_SUB='{{ opnsense_baseline.vlan_interface.subnet }}'

export WANT_KEYS WANT_PW_OFF WANT_SESSION WANT_AUTH WANT_KEA_IF WANT_VIF_HANDLE WANT_VIF_DESCR WANT_VIF_IP WANT_VIF_SUB

# ---- one PHP pass: read, compare, write only if different --------------------
cat > /tmp/opn_base.php <<'PHP'
<?php
require_once("/usr/local/etc/inc/config.inc");
require_once("/usr/local/etc/inc/util.inc");
global $config;

$wantKeys  = trim(getenv('WANT_KEYS') ?: '');
$pwOff     = getenv('WANT_PW_OFF') === '1';
$wantSess  = getenv('WANT_SESSION') ?: '';
$wantAuth  = getenv('WANT_AUTH') ?: '';
$audit     = getenv('AUDIT') === '1';

$drift = [];
$changed = false;

# --- root user index ---
$idx = null;
foreach ($config['system']['user'] as $i => $u) {
    if (($u['name'] ?? '') === 'root') { $idx = $i; break; }
}
if ($idx === null) { echo "NO_ROOT_USER\n"; exit(3); }

# --- authorized keys: the union, never a replacement ---
# OPNsense stores this field BASE64-ENCODED. Until 2026-11-25 it was compared as plaintext: the audit always
# reported the key "missing" (it was there), and an apply would have appended a plaintext key to the base64
# blob - on a router whose password login is off. Decode, compare by "type body" (a comment is not identity),
# and encode on write. A value that is not base64 of key lines is refused rather than guessed at.
$have = (string)($config['system']['user'][$idx]['authorizedkeys'] ?? '');
$dec = $have === '' ? '' : base64_decode($have, true);
if ($have !== '' && ($dec === false || !preg_match('/^(ssh-|ecdsa-|sk-)/m', $dec))) {
    echo "AUTHKEYS_UNREADABLE: root's authorizedkeys is not base64 of key lines - not touching it\n"; exit(3);
}
$lines = preg_split('/\r?\n/', $dec, -1, PREG_SPLIT_NO_EMPTY);
$ident = function ($k) { $p = preg_split('/\s+/', trim($k)); return ($p[0] ?? '') . ' ' . ($p[1] ?? ''); };
$haveIds = array_map($ident, $lines);
$missing = [];
foreach (preg_split('/\r?\n/', $wantKeys, -1, PREG_SPLIT_NO_EMPTY) as $k) {
    if (!in_array($ident($k), $haveIds, true)) { $missing[] = trim($k); }
}
if ($missing) {
    $drift[] = "authorizedkeys: " . count($missing) . " key(s) missing";
    if (!$audit) {
        foreach ($missing as $k) { $lines[] = $k; }
        $config['system']['user'][$idx]['authorizedkeys'] = base64_encode(implode("\n", $lines) . "\n");
        $changed = true;
    }
}

# --- password auth, interlocked on the presence of a key ---
$wantPw = $pwOff ? 'off' : 'on';
# if we are being asked to turn it off, a key must already exist (or be added above)
$keysAfter = $missing ? array_merge($lines, $missing) : $lines;
if ($pwOff && count(array_filter($keysAfter)) === 0) {
    $drift[] = "REFUSING to disable password auth: no authorized key would remain";
    $wantPw = 'on';
}
$curPw = isset($config['system']['ssh']['passwordauth']) ? 'on' : 'off';
if ($curPw !== $wantPw) {
    $drift[] = "ssh.passwordauth: $curPw -> $wantPw";
    if (!$audit) {
        if ($wantPw === 'on') { $config['system']['ssh']['passwordauth'] = '1'; }
        else { unset($config['system']['ssh']['passwordauth']); }
        $changed = true;
    }
}

# --- WebGUI session policy ---
if ($wantSess !== '') {
    $cur = (string)($config['system']['webgui']['session_timeout'] ?? '');
    if ($cur !== $wantSess) {
        $drift[] = "webgui.session_timeout: '" . ($cur ?: '<unset>') . "' -> '$wantSess'";
        if (!$audit) { $config['system']['webgui']['session_timeout'] = $wantSess; $changed = true; }
    }
}
if ($wantAuth !== '') {
    $cur = (string)($config['system']['webgui']['auth_timeout'] ?? '');
    if ($cur !== $wantAuth) {
        $drift[] = "webgui.auth_timeout: '" . ($cur ?: '<unset>') . "' -> '$wantAuth'";
        if (!$audit) { $config['system']['webgui']['auth_timeout'] = $wantAuth; $changed = true; }
    }
}

# --- the interface assignment and address (no provider resource exists) ---
$wantHandle = getenv('WANT_VIF_HANDLE') ?: '';
$wantIp     = getenv('WANT_VIF_IP') ?: '';
if ($wantHandle !== '' && $wantIp !== '') {
    # the device is whatever the VLAN object created; find it rather than assume the name
    $dev = '';
    $vlans = $config['vlans']['vlan'] ?? [];   # not inline: `foreach (x ?? [] as ...)` is a parse error
    foreach ($vlans as $v) {
        if ((string)($v['tag'] ?? '') === '20') { $dev = (string)($v['vlanif'] ?? ''); }
    }
    $cur = $config['interfaces'][$wantHandle] ?? [];
    if ($dev === '') {
        $drift[] = "vlan tag 20: no VLAN object - create it with opnsense_interfaces_vlan first";
    } elseif ((string)($cur['if'] ?? '') !== $dev) {
        $drift[] = "$wantHandle.if: '" . ($cur['if'] ?? '<unset>') . "' -> '$dev'";
        if (!$audit) {
            $config['interfaces'][$wantHandle] = array_merge((array)$cur, [
                'if' => $dev, 'descr' => getenv('WANT_VIF_DESCR') ?: 'CLIENTS',
                'enable' => '1', 'ipaddr' => $wantIp, 'subnet' => getenv('WANT_VIF_SUB') ?: '24',
                'ipaddrv6' => 'none', 'blockbogons' => '1',
            ]);
            $changed = true;
        }
    } elseif ((string)($cur['ipaddr'] ?? '') !== $wantIp) {
        $drift[] = "$wantHandle.ipaddr: '" . ($cur['ipaddr'] ?? '<unset>') . "' -> '$wantIp'";
        if (!$audit) { $config['interfaces'][$wantHandle]['ipaddr'] = $wantIp; $changed = true; }
    }
}

if (!$drift) { echo "OK\n"; exit(0); }

if ($audit) {
    echo "DRIFT\n";
    foreach ($drift as $d) { echo "  $d\n"; }
    exit(2);
}

if ($changed) {
    write_config('bakuran: identity/access baseline (keys, password auth, session policy)');
}
echo "CHANGED\n";
foreach ($drift as $d) { echo "  $d\n"; }

# apply the sshd config if the auth policy moved
$sshd = '/usr/local/etc/ssh/sshd_config';
$want = $wantPw === 'on' ? 'yes' : 'no';
$cur = 'none';
foreach (@file($sshd) ?: [] as $l) { if (preg_match('/^PasswordAuthentication\s+(\w+)/', $l, $m)) { $cur = $m[1]; } }
if ($cur !== $want) {
    echo "  restarting openssh to apply PasswordAuthentication=$want\n";
    @exec('configctl openssh restart 2>&1');
}
PHP

AUDIT="$AUDIT" php /tmp/opn_base.php
rc=$?
rm -f /tmp/opn_base.php

# Kea's interface selection is a MODEL field, not a config.xml string: writing the text is not
# enough (the model keeps its own selection flags, and the generator reads those). setValue with a
# comma STRING is the working form - an array writes the literal word "Array" into the config,
# which is a mistake worth never repeating.
if [ -n "${WANT_KEA_IF:-}" ]; then
  cat > /tmp/keaif.php <<'PHP2'
<?php
require_once("/usr/local/etc/inc/config.inc");
require_once("/usr/local/etc/inc/util.inc");
require_once("/usr/local/opnsense/mvc/app/config/loader.php");
$want = getenv('WANT_KEA_IF');
$m = new \OPNsense\Kea\KeaDhcpv4();
$cur = implode(',', $m->general->interfaces->getValues());
if ($cur !== $want) {
    if (getenv('AUDIT') === '1') { echo "KEA_DRIFT\n"; exit(2); }
    $m->general->interfaces->setValue($want);
    $m->serializeToConfig(false, true);
    \OPNsense\Core\Config::getInstance()->save();
    echo "kea interfaces: '$cur' -> '$want'\n";
    @exec('configctl kea restart 2>&1');
}
PHP2
  AUDIT="$AUDIT" WANT_KEA_IF="$WANT_KEA_IF" php /tmp/keaif.php; krc=$?
  rm -f /tmp/keaif.php
  if [ "$krc" = "2" ]; then CHANGED=1; echo "  kea interfaces differ from '$WANT_KEA_IF'"; fi
fi


# ---- cron entries with no config.xml equivalent -------------------------------------
# Both of these were created by hand and live only in /etc/cron.d, which is *not* part of an
# OPNsense configuration backup (that is /conf/config.xml). A reinstall loses them silently:
# DNSBL stops refreshing and the dead-man's switch stops running, with nothing to show for it.
#
# They cannot become OPNsense "cron jobs" either: that plugin's command field only accepts
# registered configd actions, and the heartbeat is a plain script. So they are templated here,
# which is the thing that makes a rebuild reproduce them.
ensure_cron() { # <path> <content>
    _path=$1
    _want=$2
    if [ -f "$_path" ] && [ "$(cat "$_path")" = "$_want" ]; then
        return 0
    fi
    if [ "$AUDIT" = "1" ]; then
        add_drift "cron: $_path missing or different"
        return 2
    fi
    printf '%s\n' "$_want" > "$_path" || return 4
    chmod 644 "$_path"
    echo "cron: wrote $_path"
    return 3
}

# The content below is compared byte-for-byte, so it must be the *whole* file, comments
# included - that is how they exist on the box, and the comments are what tell the next
# person how to verify each one. Lines start at column 0 inside the quotes on purpose.
CRON_DNSBL="# Refresh the Unbound DNSBL cache (adblock). OPNsense ships no GUI cron for this.
# Verify: date -r /var/unbound/data/dnsbl.json   (mtime should move daily ~03:15)
15 3 * * * root /usr/local/opnsense/scripts/unbound/blocklists.py update > /dev/null 2>&1"

CRON_HEARTBEAT="# Dead-man's switch: poll the cluster from outside its failure domain.
# Verify: tail /var/log/homelab-heartbeat.log
*/5 * * * * root /usr/local/etc/homelab-heartbeat.sh >/dev/null 2>&1"

ensure_cron /etc/cron.d/dnsbl "$CRON_DNSBL"
drc=$?
ensure_cron /etc/cron.d/homelab-heartbeat "$CRON_HEARTBEAT"
hrc=$?
[ "$drc" = "4" ] || [ "$hrc" = "4" ] && rc=1
[ "$drc" = "2" ] || [ "$hrc" = "2" ] && rc=2

# ---- gateway monitoring and DNSSEC: owned by OpenTofu since 2026-11-25 ----------------
# opentofu/opnsense: opnsense_system_gateway.wan_dhcp (monitor 1.1.1.1 - the ISP gateway drops ICMP) and
# opnsense_unbound_general.resolver (dnssec). Provider 0.31.1 has resources for both; 0.14 had neither,
# which is why they lived here. Two owners of one fact would correct each other, so this section is gone.

# ---- Unbound DNSBL blocklist --------------------------------------------------------
# The one piece of ad-blocking config that is data rather than a flag: a single blocklist
# entry (type oisd0, NXDOMAIN for blocked names, 72h cache). It lives in the encrypted
# config export, but "in a backup" is not the same as "reproducible" - this makes it both.
cat > /tmp/dnsbl.php <<'PHP_DNSBL'
<?php
require_once("config.inc");
require_once("util.inc");
$audit = getenv('AUDIT') === '1';
$want  = ['enabled' => '1', 'type' => 'oisd0', 'nxdomain' => '1', 'cache_ttl' => '72000'];
// The XML has one <blocklist> element, which the config array represents as the entry
// itself - not a list of entries. Handle both shapes rather than assuming: reading it as a
// list found no 'type' key and reported the entry missing (2026-11-03).
$blocks = $config['OPNsense']['unboundplus']['dnsbl']['blocklist'] ?? [];
$idx = null;
if (isset($blocks['type'])) {
    if ($blocks['type'] === 'oisd0') { $idx = null; $single = $blocks; }
} else {
    foreach ($blocks as $i => $b) {
        if (is_array($b) && ($b['type'] ?? '') === 'oisd0') { $idx = $i; $single = $b; break; }
    }
}
$entry = $single ?? null;
if ($entry === null) {
    // Creating one means minting a uuid and a full entry shape; not guessing that here.
    echo "DNSBL_MISSING: no oisd0 blocklist entry\n";
    exit(4);
}
$diff = [];
foreach ($want as $k => $v) {
    if ((string)($entry[$k] ?? '') !== $v) { $diff[] = $k; }
}
if (empty($diff)) { echo "dnsbl OK (oisd0)\n"; exit(0); }
if ($audit) { echo "DNSBL_DRIFT: " . implode(', ', $diff) . "\n"; exit(2); }
$path = ($idx === null)
    ? 'OPNsense/unboundplus/dnsbl/blocklist'
    : 'OPNsense/unboundplus/dnsbl/blocklist/' . $idx;
foreach ($want as $k => $v) {
    $ref = &$config;
    foreach (explode('/', $path) as $seg) { $ref = &$ref[$seg]; }
    $ref[$k] = $v;
    unset($ref);
}
write_config('homelab baseline: DNSBL blocklist');
echo "dnsbl corrected (" . implode(', ', $diff) . "); the list rebuilds on the 03:15 cron\n";
exit(3);
PHP_DNSBL
AUDIT="$AUDIT" php /tmp/dnsbl.php
brc=$?
rm -f /tmp/dnsbl.php
[ "$brc" = "3" ] && rc=1
[ "$brc" = "2" ] && rc=2
[ "$brc" = "4" ] && { echo "  no oisd0 entry - leaving it alone"; rc=1; }

# ---- administrative settings with no provider resource -------------------------------
# Five fields, none of which changes how a client behaves, all of which are one lookup away
# from being wrong on a rebuilt router. Grouped in one PHP block because they fail the same
# way: silently, and only noticed months later.
cat > /tmp/admin.php <<'PHP_ADMIN'
<?php
require_once("config.inc");
require_once("util.inc");
$audit = getenv('AUDIT') === '1';
$changed = [];

// want(scope, path, value)
$want = [
    // Key names verified against /usr/local/etc/inc/plugins.inc.d/webgui.inc, which is the
    // only thing that reads them. The first version of this block set `redirect_http` and
    // `hsts` - neither exists, so the values landed in config.xml and changed nothing.
    // Redirect is opt-OUT: `disablehttpredirect` unset means HTTP is already redirected.
    ['system/webgui', 'ssl-hsts', '1', 'HSTS enabled'],
    // NOTE: the HTTP->HTTPS redirect is controlled by `disablehttpredirect`, and webgui.inc
    // tests `!isset(...)` - so the redirect is ON only while that key is ABSENT. Writing
    // '0' into it disables the redirect and lighttpd stops listening on :80 entirely
    // (verified 2026-11-03: :80 went from 301 to connection refused). It is therefore
    // handled below as "must not exist" rather than as a value to set.
    // passwordauth is presence-based too: OPNsense treats the key existing as "on", so
    // disabling it means removing the key, not writing '0'. Handled as "must not exist".
    ['dnsmasq',       'enable',        '0', 'dnsmasq disabled (Unbound serves DNS, Kea serves DHCP)'],
    ['OPNsense/unboundplus/general', 'regdhcp',       '1', 'Unbound registers DHCP leases'],
    ['OPNsense/unboundplus/general', 'regdhcpstatic', '1', 'Unbound registers static mappings'],
];

$ref = &$config;
foreach ($want as $w) {
    [$scope, $key, $value, $desc] = $w;
    $path = str_replace('/', "\x00", $scope);
    $node = &$config;
    foreach (explode('/', $scope) as $seg) { $node = &$node[$seg]; }
    $cur = (string)($node[$key] ?? '');
    if ($cur === $value) { unset($node); continue; }
    $changed[] = sprintf('%s: %s -> %s (%s)', $scope . '.' . $key, $cur === '' ? 'unset' : $cur, $value, $desc);
    unset($node);
}

// Clean up the two keys an earlier version of this block wrote. They are read by nothing,
// and leaving invented keys in config.xml is how a config becomes folklore.
// system/ssh.passwordauth: presence means "password auth enabled" (see the SSH section
// above, which unsets it). Remove it here too so both blocks agree on the same rule.
if (isset($config['system']['ssh']['passwordauth'])) {
    unset($config['system']['ssh']['passwordauth']);
    $changed[] = 'system/ssh.passwordauth: must not exist - removed';
}

// Keys that must NOT exist for the intended behaviour, not keys to set:
//   disablehttpredirect - webgui.inc redirects only while this key is absent
//   hsts, redirect_http - invented by the first version of this block; nothing reads them
foreach (['disablehttpredirect', 'passwordauth', 'hsts', 'redirect_http'] as $bogus) {
    if (isset($config['system']['webgui'][$bogus])) {
        unset($config['system']['webgui'][$bogus]);
        $changed[] = "system/webgui.$bogus: must not exist - removed";
    }
}

if (empty($changed)) { echo "admin settings OK\n"; exit(0); }
if ($audit) {
    foreach ($changed as $c) { echo "ADMIN_DRIFT: $c\n"; }
    exit(2);
}
foreach ($want as $w) {
    [$scope, $key, $value] = $w;
    $node = &$config;
    foreach (explode('/', $scope) as $seg) { $node = &$node[$seg]; }
    $node[$key] = $value;
    unset($node);
}
write_config('homelab baseline: administrative settings');
foreach ($changed as $c) { echo "admin: $c\n"; }
// The web GUI and sshd pick these up on reload; unbound needs a restart for the
// registration flags to take effect in its generated config.
@exec('configctl webgui restart 2>&1');
@exec('service sshd reload 2>&1');
@exec('configctl unbound restart 2>&1');
if ((string)($config['dnsmasq']['enable'] ?? '0') === '0') { @exec('/usr/local/etc/rc.d/dnsmasq stop 2>&1'); }
exit(3);
PHP_ADMIN
AUDIT="$AUDIT" php /tmp/admin.php
arc=$?
rm -f /tmp/admin.php
[ "$arc" = "3" ] && rc=1
[ "$arc" = "2" ] && rc=2

case "$rc" in
  0) [ "$AUDIT" = "1" ] && echo "OK: identity/access baseline matches; nothing to change." ;;
  2) echo "DRIFT detected (audit mode): rerun without --audit to correct it." ;;
  *) echo "FAILED (rc=$rc)" ;;
esac
exit $rc
