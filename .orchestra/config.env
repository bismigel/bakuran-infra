# Orchestra config for bakuran-infra (Forgejo origin, PR-only, OpenTofu checks).
ORCHESTRA_BASE=forgejo/main
ORCHESTRA_LAND=pr
ORCHESTRA_PR_CMD="$HOME/projects/orchestra/examples/forgejo-pr.sh"
ORCHESTRA_STATE_CMD='echo "=== unmerged remote branches ==="; git branch -r --no-merged forgejo/main; echo "=== nodes ==="; kubectl get nodes -o wide 2>/dev/null || true'
ORCHESTRA_GATE='tofu fmt -check -diff opentofu/cloudflare opentofu/opnsense opentofu/media opentofu/omada'
